<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Windows application manifest. activeCodePage forces the process's ANSI code page to UTF-8
  (Windows 10 1903+), so every narrow-char file API — tinyobjloader's std::ifstream, stb/tinyexr's
  fopen, std::filesystem::path — agrees with the UTF-8 strings QString::toStdString() produces.
  Without it, importing from a folder with non-ASCII characters (é, ü, CJK) fails on systems whose
  legacy ANSI code page isn't UTF-8. CMake embeds this via the MSVC manifest tool automatically
  when the file is listed in target_sources.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
