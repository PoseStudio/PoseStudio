/**
 * @file _menumanager.qss
 * @brief The menu bar and EVERY QMenu in the app: the menu-bar dropdowns (src/shell/menumanager.*),
 *        context menus, and the picker menus (the viewport's shader/view pickers, the Environment
 *        tab's HDRI and backdrop pickers) all inherit this one look.
 *
 * Concatenated after global.qss (shell/apptheme.cpp). Keep menu styling here and only here — a
 * per-menu override anywhere else is how the pickers stop matching the File/Edit menus.
 */

/* =========================================================================
   [ MENU BAR ]
   ========================================================================= */

QMenuBar {
    padding: 4px; 
    border-bottom: 1px solid #313131;
    background-color: #191a1b; 
    color: white; 
}

QMenuBar::item {
    padding: 6px 12px;
    /* A transparent background (and matching radius) forces this base state through the same
       stylesheet box rendering as :selected below. Without it, the unstyled base renders
       natively while the hovered state renders via the stylesheet, and the two paths lay the
       text out slightly differently — the "font changes / shifts on hover" artifact. */
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    border-radius: 4px;
    background-color: #314D7A;
}

/* =========================================================================
   [ DROPDOWN MENUS ]
   ========================================================================= */

/* Rounded corners make a QMenu a *translucent* popup window, which on Windows gets a heavy native drop
   shadow. We keep the rounded corners and instead strip that shadow app-wide via MenuShadowFilter in
   shell/apptheme.cpp (it sets Qt::NoDropShadowWindowHint on every menu and masks the popup to the
   4px radius below). Result: rounded corners, no shadow. Change the radius here and there together. */
QMenu {
    padding: 4px;
    border: 1px solid #555555;
    border-radius: 4px;
    background-color: #252627;
    color: white;
}

QMenu::item {
    padding: 6px 4px 6px 6px;
}

QMenu::item:selected {
    border-radius: 4px;
    background-color: #314D7A;
}

QMenu::item:disabled {
    color: #929292;
}

/* Separators between item groups — EVERY QMenu in the app (the menu-bar dropdowns, context
   menus, the viewport's shader picker, the HDRI menu). A clearly visible mid grey: the default
   near-black hairline vanished against the #252627 surface, so the groups read as one list.
   The same grey (Constants::COLOR_SEPARATOR) draws the Asset Manager's section and search
   dividers and the HDRI menu's category rules — one separator color app-wide. */
QMenu::separator {
    height: 1px;
    background: #6a6b6e;
    margin: 5px 8px 5px 8px;
}