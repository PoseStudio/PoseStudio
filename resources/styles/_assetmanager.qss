/* =========================================================================
   [ TOP PANEL & HEADER ]
   ========================================================================= */

#AssetManagerTopPanel {
    background-color: #252627;
    border-radius: 4px;
}

#AssetManagerTitle {
    padding: 10px;
    color: #cccccc; 
    font-size: 14px; 
    font-weight: bold; 
}

/* =========================================================================
   [ SEARCH BAR ]
   ========================================================================= */

#AssetManagerSearchRow {
    background-color: #252627;
}

#AssetManagerSearchInput {
    background-color: #1e1f20;
    border: 1px solid #3a3b3c;
    border-radius: 4px;
    color: #cccccc;
    padding: 3px 6px;
    font-size: 12px;
    selection-background-color: #314d7a;
}

#AssetManagerSearchInput:focus {
    border: 1px solid #4a6a9a;
    outline: none;
}

#AssetManagerClearButton,
#AssetManagerSearchButton {
    background-color: #3a3b3c;
    border: 1px solid #4a4b4c;
    border-radius: 4px;
    padding: 0px;
}

#AssetManagerClearButton:hover,
#AssetManagerSearchButton:hover {
    background-color: #4a4b4c;
}

#AssetManagerClearButton:pressed,
#AssetManagerSearchButton:pressed {
    background-color: #314d7a;
    border-color: #4a6a9a;
}

#AssetManagerSearchSeparator {
    /* The app-wide separator grey (Constants::COLOR_SEPARATOR). */
    color: #6a6b6e;
    background-color: #6a6b6e;
    max-height: 1px;
    border: none;
}

/* =========================================================================
   [ DIRECTORY TREE ]
   ========================================================================= */

#AssetManagerTree {
    /* The app-wide separator grey (Constants::COLOR_SEPARATOR, QMenu::separator in
       _menumanager.qss), injected into the C++ delegate's separator rows via Q_PROPERTY. */
    qproperty-separatorColor: #6a6b6e;
    padding: 4px;
    background-color: #252627;
    border: none;
    border-radius: 4px;
    outline: none; /* Removes the dotted focus ring */
    color: #cccccc;
}

#AssetManagerTree::item {
    padding: 4px;
}

#AssetManagerTree::item:hover {
    background-color: #2a2c2e;
}

#AssetManagerTree::item:selected {
    background-color: #314d7a;
    color: #ffffff;
}

/* =========================================================================
   [ ASSET GRID ]
   ========================================================================= */

#AssetManagerGrid {
    padding: 8px;
    background-color: #1a1b1c; 
    border: 1px solid #2a2b2c;
    border-radius: 4px;
    outline: none;
}

#AssetManagerGrid::item {
    padding: 4px;
    background-color: transparent; 
    border: 1px solid transparent; /* This prevents the 1px jitter! */
    border-radius: 6px;
    color: #aaaaaa;
}

#AssetManagerGrid::item:hover {
    background-color: #2a2d30;
    border: 1px solid #3c3c3c; 
    color: #ffffff; 
}

#AssetManagerGrid::item:selected {
    background-color: #25344b; /* The dark gray background */
    border: 1px solid #314d7a; /* Your custom blue accent border */
    color: #ffffff;
}

/* =========================================================================
   [ INFO BAR FOOTER ]
   ========================================================================= */

#AssetManagerInfoBar {
    padding: 0px 4px 8px 12px;
    color: #aaaaaa;
    font-size: 12px;
}

#AssetManagerAddLibraryHint {
    font-size: 14px;
}

/* ========================================================================= */
/* ASSET MANAGER CONTEXT MENU                                                */
/* ========================================================================= */

QMenu#AssetManagerContextMenu { 
    border: 1px solid #4a4b4c; 
    background-color: #1a1b1c; /* Matches your dark theme */
    icon-size: 12px;
}

QMenu#AssetManagerContextMenu::item { 
    padding: 5px 25px 5px 10px; 
    color: #e0e0e0; 
}

QMenu#AssetManagerContextMenu::item:selected { 
    background-color: #2a2d30; /* Highlight color on hover */
}

QMenu#AssetManagerContextMenu::icon { 
    padding-left: 12px; 
}

/* Separators: the global QMenu::separator rule (_menumanager.qss) — one color app-wide. */

QMenu#AssetManagerContextMenu::item:disabled {
    color: #666666; /* Muted, greyed-out text */
    background-color: transparent; /* Ensures it doesn't highlight on hover */
}
