/* ============================================================================
 * _environment.qss — the Environment properties tab (see src/properties/environmentpanel.*)
 * Concatenated after global.qss (main.cpp loadStylesheets), so these rules override the base.
 * Everything is scoped under #EnvironmentPanel so it can't leak into other widgets.
 * Palette matches the app: pane #252627, inputs #2a2b2d, borders #3a3b3d/#4a4b4d,
 * accent #5b87cc, hover #314D7A, text #e0e0e0.
 * ==========================================================================*/

#EnvironmentPanel,
#EnvironmentContent {
    background-color: #252627; /* same as the QTabWidget::pane the tab sits in */
}

#EnvironmentPanel QScrollArea {
    background: transparent;
    border: none;
}

/* Row labels: the global QLabel rule is white/18px — far too big here. Reset to the app's body size. */
#EnvironmentPanel QLabel {
    color: #c7c8cb;
    font-size: 12px;
    padding: 0;
}

/* Section frames. */
#EnvironmentGroup {
    border: 1px solid #3a3b3d;
    border-radius: 5px;
    margin-top: 14px;       /* room for the title sitting on the top border */
    padding: 12px 8px 8px 8px;
    font-size: 12px;
    color: #cfcfd2;
}
#EnvironmentGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #8b9096;
}

/* HDRI selector: a button showing the current environment's name; clicking drops a menu hosting a
 * scrollable thumbnail list (#HdriList) + a footer link. The menu chrome ("HdriMenu") inherits the
 * app-wide QMenu look from _menumanager.qss, exactly like the viewport's shader-mode menu. */
#EnvironmentHdriButton {
    background-color: #2a2b2d;
    color: #e0e0e0;
    border: 1px solid #4a4b4d;
    border-radius: 4px;
    padding: 4px 24px 4px 18px; /* generous left inset for the name; right room for the indicator */
    min-height: 20px;
    text-align: left;
}
#EnvironmentHdriButton:hover { border-color: #5b87cc; }
#EnvironmentHdriButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

/* The thumbnail list inside the HDRI menu: tight rows, menu-style hover/selection, dark scroll bar. */
#HdriList {
    background-color: #252627;
    color: #e0e0e0;
    outline: none; /* no dotted focus ring */
}
#HdriList::item {
    padding: 2px 6px;   /* tight vertical rhythm between rows */
}
#HdriList::item:hover    { background-color: #314D7A; color: #ffffff; }
#HdriList::item:selected { background-color: #2f3f5c; color: #ffffff; }
#HdriList QScrollBar:vertical {
    background: #252627;
    width: 10px;
    margin: 0;
}
#HdriList QScrollBar::handle:vertical {
    background: #4a4b4d;
    border-radius: 5px;
    min-height: 24px;
}
#HdriList QScrollBar::handle:vertical:hover { background: #5b87cc; }
#HdriList QScrollBar::add-line:vertical,
#HdriList QScrollBar::sub-line:vertical { height: 0; }
#HdriList QScrollBar::add-page:vertical,
#HdriList QScrollBar::sub-page:vertical { background: transparent; }

/* Footer link under the list: left-justified, quiet, menu-item hover. */
#HdriFolderLink {
    background: transparent;
    color: #c7c8cb;
    border: none;
    border-radius: 4px;
    padding: 5px 8px;
    text-align: left;
}
#HdriFolderLink:hover {
    background-color: #314D7A;
    color: #ffffff;
}
#HdriEmptyLabel { color: #8b9096; }

/* Numeric spin boxes. */
#EnvironmentPanel QDoubleSpinBox {
    background-color: #2a2b2d;
    color: #e0e0e0;
    border: 1px solid #4a4b4d;
    border-radius: 4px;
    padding: 2px 4px;
    selection-background-color: #5b87cc;
}
#EnvironmentPanel QDoubleSpinBox:hover { border-color: #5b87cc; }
#EnvironmentPanel QDoubleSpinBox::up-button,
#EnvironmentPanel QDoubleSpinBox::down-button {
    background-color: #333436;
    width: 14px;
    border: none;
}
#EnvironmentPanel QDoubleSpinBox::up-button:hover,
#EnvironmentPanel QDoubleSpinBox::down-button:hover {
    background-color: #3f4042;
}
/* +/- glyphs so the increment/decrement buttons read at a glance (up = +, down = -). */
#EnvironmentPanel QDoubleSpinBox::up-arrow {
    image: url(:/resources/icons/plus.png);
    width: 7px;
    height: 7px;
}
#EnvironmentPanel QDoubleSpinBox::down-arrow {
    image: url(:/resources/icons/minus.png);
    width: 7px;
    height: 7px;
}

/* Sliders: thin groove, accent fill, round handle. */
#EnvironmentPanel QSlider::groove:horizontal {
    height: 4px;
    background: #3a3b3d;
    border-radius: 2px;
}
#EnvironmentPanel QSlider::sub-page:horizontal {
    background: #5b87cc;
    border-radius: 2px;
}
#EnvironmentPanel QSlider::handle:horizontal {
    background: #cfd3d8;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}
#EnvironmentPanel QSlider::handle:horizontal:hover { background: #ffffff; }

/* Tonemap checkbox. */
#EnvironmentPanel QCheckBox {
    color: #c7c8cb;
    font-size: 12px;
    spacing: 6px;
}
#EnvironmentPanel QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4a4b4d;
    border-radius: 3px;
    background: #2a2b2d;
}
#EnvironmentPanel QCheckBox::indicator:checked {
    background: #5b87cc;
    border-color: #5b87cc;
}

/* Reset button: quiet, secondary. */
#EnvironmentResetButton {
    background-color: #2a2b2d;
    color: #d0d0d3;
    border: 1px solid #4a4b4d;
    border-radius: 4px;
    padding: 5px 12px;
}
#EnvironmentResetButton:hover {
    background-color: #314D7A;
    color: #ffffff;
}
