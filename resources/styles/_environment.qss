/**
 * @file _environment.qss
 * @brief The properties tabs: Environment (src/properties/environmentpanel.* and hdriselector.*),
 *        Transform (src/properties/transformpanel.*), Materials (materialpanel.*) and Soft Body
 *        Physics (softbodypanel.*).
 *
 * Concatenated after global.qss (shell/apptheme.cpp), so these rules override the base.
 * Everything is scoped under #EnvironmentPanel / #TransformPanel / #SoftBodyPanel or the tabs' own object names so
 * it can't leak into other widgets; what the tabs share — the section frames, the per-row restore
 * button, the quiet reset button (built by src/properties/propertyrows.*) — is styled ONCE, under
 * the #Property… names. Palette matches the app: pane #252627, inputs #2a2b2d, borders
 * #3a3b3d/#4a4b4d, accent #5b87cc, hover #314D7A, text #e0e0e0.
 */

#EnvironmentPanel,
#EnvironmentContent,
#TransformPanel,
#TransformContent,
#MaterialPanel,
#MaterialContent,
#SoftBodyPanel,
#SoftBodyContent {
    background-color: #252627; /* same as the QTabWidget::pane the tab sits in */
}

#EnvironmentPanel QScrollArea,
#TransformPanel QScrollArea,
#MaterialPanel QScrollArea,
#SoftBodyPanel QScrollArea {
    background: transparent;
    border: none;
}

/* Row labels: the global QLabel rule is white/18px — far too big here. Reset to the app's body size. */
#EnvironmentPanel QLabel,
#TransformPanel QLabel,
#MaterialPanel QLabel,
#SoftBodyPanel QLabel {
    color: #c7c8cb;
    font-size: 12px;
    padding: 0;
}
/* A row whose dial the selected joint does not have (or no joint selected): the label dims with it. */
#TransformPanel QLabel:disabled { color: #6f7073; }
#MaterialPanel QLabel:disabled { color: #6f7073; }
#SoftBodyPanel QLabel:disabled { color: #6f7073; }

/* The Materials tab's heading (the selected object's name) and its hint lines (the zone note, the
 * maps list, the how-to while nothing is selected). The Base Color swatch's look is set in code:
 * its background IS the color (materialpanel.cpp). */
#MaterialPanel #MaterialObjectName {
    color: #e0e0e0;
    font-size: 13px;
    font-weight: bold;
}
#MaterialPanel #MaterialHint { color: #8b9096; }
#MaterialPanel QCheckBox { color: #c7c8cb; font-size: 12px; }
#MaterialPanel QCheckBox:disabled { color: #6f7073; }

/* Collapsible sections (propertyrows::addCollapsibleGroup — the Materials tab's Base, Specular,
 * Coat …): a header button with an arrow over a body, framed like #PropertyGroup. */
#PropertyCollapsible {
    border: 1px solid #3a3b3d;
    border-radius: 5px;
    background: transparent;
}
#PropertyCollapsibleHeader {
    color: #cfcfd2;
    font-size: 12px;
    font-weight: bold;
    padding: 5px 8px;
    border: none;
    border-radius: 4px;
    text-align: left;
    background: transparent;
}
#PropertyCollapsibleHeader:hover { background-color: #2d2e31; }
#PropertyCollapsibleHeader:checked { color: #e0e0e0; }
#PropertyCollapsibleBody { background: transparent; }

/* The Textures group's rows: the bound map's name (elided), and the three small buttons —
 * choose a file, clear, back to the imported map. */

/* The Materials tab's layer switches, at the right of a section header. */
#MaterialPanel #PropertyLayerToggle { spacing: 0px; }

/* The Overlays header's summary while folded: a "+" (drawn in code: PlusMark) with no overlay,
 * else the count. Marks on the header, not controls: no background, no hover of their own. */
#MaterialSectionCount {
    color: #cfcfd2;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 0px;
}

/* The Overlays section's cards (overlaystack.cpp): one framed card per overlay — a header (the
 * color image's thumbnail, the fold arrow + name, the on/off switch, move up / down, remove)
 * over its controls. A shade lighter than the pane, so a stack of them reads as layers. */
#OverlayCard {
    border: 1px solid #3a3b3d;
    border-radius: 5px;
    background-color: #2a2b2d;
}
#OverlayCardHeader {
    color: #dcdcdf;
    font-size: 12px;
    padding: 3px 4px;
    border: none;
    border-radius: 4px;
    text-align: left;
    background: transparent;
}
#OverlayCardHeader:hover { background-color: #333437; }
/* The header's inline name editor (Rename…). */
#OverlayNameEditor {
    background-color: #1f2022;
    color: #e0e0e0;
    font-size: 12px;
    border: 1px solid #5b87cc;
    border-radius: 4px;
    padding: 0 4px;
    selection-background-color: #314D7A;
    selection-color: #ffffff;
}
#OverlayCardButton {
    color: #b8b9bc;
    font-size: 15px;
    border: none;
    border-radius: 3px;
    padding: 0;
    background: transparent;
}
#OverlayCardButton:hover    { background-color: #314D7A; color: #ffffff; }
#OverlayCardButton:pressed  { background-color: #2f3f5c; }
#OverlayCardButton:disabled { color: #55565a; }

/* The Transform tab's heading (the selected joint's name) and its hint line under the rows. */
#TransformPanel #TransformJointName {
    color: #e0e0e0;
    font-size: 13px;
    font-weight: bold;
}
#TransformPanel #TransformHint { color: #8b9096; }
#SoftBodyPanel #SoftBodyHint { color: #8b9096; }

/* Section frames. */
#PropertyGroup {
    border: 1px solid #3a3b3d;
    border-radius: 5px;
    margin-top: 14px;       /* room for the title sitting on the top border */
    padding: 12px 8px 8px 8px;
    font-size: 12px;
    color: #cfcfd2;
}
#PropertyGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #8b9096;
}

/* HDRI selector (HdriSelector, hdriselector.cpp): a button showing the current environment's name;
 * clicking drops a menu hosting a scrollable thumbnail list (#HdriList) + a footer link. The menu
 * chrome inherits the app-wide QMenu look from _menumanager.qss, exactly like the viewport's
 * shader-mode menu. The Backdrop tab's Mode picker deliberately shares this object name, so the
 * two fields look identical. */
#EnvironmentHdriButton {
    background-color: #2a2b2d;
    color: #e0e0e0;
    border: 1px solid #4a4b4d;
    border-radius: 4px;
    padding: 4px 24px 4px 18px; /* generous left inset for the name; right room for the indicator */
    min-height: 20px;
    text-align: left;
}
#EnvironmentHdriButton:hover { border-color: #5b87cc; }
#EnvironmentHdriButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

/* The thumbnail list inside the HDRI menu: tight rows, menu-style hover/selection, dark scroll bar.
 * Category headings (one per hdri/ subfolder) are disabled QListWidgetItems painted by a delegate in
 * code (hdriselector.cpp HdriHeadingDelegate: a top gap, bold #e0e0e0 text, and a rule under it in
 * the app-wide separator grey #6a6b6e — Constants::COLOR_SEPARATOR, the same value as
 * QMenu::separator below in _menumanager.qss) — QSS can't address individual items, so no rule here. */
#HdriList {
    background-color: #252627;
    color: #e0e0e0;
    outline: none; /* no dotted focus ring */
}
#HdriList::item {
    padding: 2px 6px;   /* tight vertical rhythm between rows */
}
#HdriList::item:hover    { background-color: #314D7A; color: #ffffff; }
#HdriList::item:selected { background-color: #2f3f5c; color: #ffffff; }
#HdriList QScrollBar:vertical {
    background: #252627;
    width: 10px;
    margin: 0;
}
#HdriList QScrollBar::handle:vertical {
    background: #4a4b4d;
    border-radius: 5px;
    min-height: 24px;
}
#HdriList QScrollBar::handle:vertical:hover { background: #5b87cc; }
#HdriList QScrollBar::add-line:vertical,
#HdriList QScrollBar::sub-line:vertical { height: 0; }
#HdriList QScrollBar::add-page:vertical,
#HdriList QScrollBar::sub-page:vertical { background: transparent; }

/* Footer link under the list: left-justified, quiet, menu-item hover. */
#HdriFolderLink {
    background: transparent;
    color: #c7c8cb;
    border: none;
    border-radius: 4px;
    padding: 5px 8px;
    text-align: left;
}
#HdriFolderLink:hover {
    background-color: #314D7A;
    color: #ffffff;
}
#HdriEmptyLabel { color: #8b9096; }

/* Numeric rows are DragNumberBoxes (src/widgets/dragnumberbox.*) — the app-standard scrub field.
 * It paints itself in C++ with the palette above as defaults; re-theme via its color Q_PROPERTYs
 * (qproperty-fillColor etc.) if a container ever needs a different look. No rules needed here. */

/* Per-row restore-default button (the small icon right of each DragNumberBox): quiet until
 * hovered, then the app-wide menu-hover blue. */
#PropertyRowRestore {
    border: none;
    background: transparent;
    padding: 2px;
    border-radius: 3px;
}
#PropertyRowRestore:hover   { background-color: #314D7A; }
#PropertyRowRestore:pressed { background-color: #2f3f5c; }

/* The toggles (tonemap, shadows): the label matches the row labels; the indicator itself is the
 * app-wide QCheckBox::indicator rule in global.qss. */
#EnvironmentPanel QCheckBox,
#SoftBodyPanel QCheckBox {
    color: #c7c8cb;
    font-size: 12px;
    spacing: 6px;
}
/* The Soft Body Physics tab's part switches dim with the master switch off. */
#SoftBodyPanel QCheckBox:disabled { color: #6f7073; }

/* Reset button: quiet, secondary. */
#PropertyResetButton {
    background-color: #2a2b2d;
    color: #d0d0d3;
    border: 1px solid #4a4b4d;
    border-radius: 4px;
    padding: 5px 12px;
}
#PropertyResetButton:hover {
    background-color: #314D7A;
    color: #ffffff;
}
#PropertyResetButton:disabled {
    color: #6f7073;
    border-color: #3a3b3d;
}
