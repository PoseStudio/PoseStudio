/**
 * @file global.qss
 * @brief Primary application stylesheet for PoseStudio.
 * * This file establishes the foundational dark theme and sets the baseline rules 
 * for standard Qt widgets (MainWindow, Splitters, Tabs). Module-specific styling 
 * (e.g., Asset Manager, Menus) should be handled in their respective _module.qss files.
 */

/* ========================================================================= */
/* [ APPLICATION ROOT ]                                                      */
/* ========================================================================= */

QMainWindow { 
    /* Base application background (Dark Theme Foundation) */
    background-color: #191a1b; 
}

QLabel { 
    color: #ffffff; 
    font-size: 18px; 
    padding: 4px;
}

/* ========================================================================= */
/* [ SPLITTERS (RESIZABLE PANELS) ]                                          */
/* ========================================================================= */

QSplitter::handle { 
    /* Subtle separation between main UI panels */
    background-color: #1a1b1c; 
}

QSplitter::handle:horizontal { 
    width: 6px;
}

QSplitter::handle:vertical { 
    height: 4px; 
}

/* --- Splitter Interactions --- */

QSplitter::handle:hover { 
    /* Slightly lighten the handle so the user knows it can be dragged */
    background-color: #3a3b3c; 
}

QSplitter::handle:pressed {
    /* PoseStudio primary highlight color when actively resizing */
    background-color: #5b87cc; 
}

/* ========================================================================= */
/* [ SIDEBAR TABS (QTabWidget) ]                                             */
/* ========================================================================= */

QTabWidget::pane { 
    /* Remove native 3D borders from the Fusion style to keep it flat */
    border: none; 
    background-color: #252627; 
}

QTabBar::tab { 
    background-color: #191a1b; 
    color: #929292; 
    padding: 12px 6px; 
    
    /* Establish the boundary between unselected tabs */
    border: 1px solid #121212; 
    border-right: none; 
    
    /* Soften the outer edge (assumes West-aligned tabs) */
    border-top-left-radius: 4px; 
    border-bottom-left-radius: 4px; 
    margin-bottom: 2px;
}

/* --- Tab Interactions --- */

QTabBar::tab:selected { 
    /* Active tab blends seamlessly into the QTabWidget pane color */
    background-color: #252627; 
    color: white; 
}

QTabBar::tab:hover:!selected { 
    /* Subtle highlight for inactive tabs when moused over */
    background-color: #2a2a2a; 
}

/* ========================================================================= */
/* [ TOOLTIPS ]                                                              */
/* ========================================================================= */
QToolTip {
    background-color: #1e1f22; /* Matches your viewport background */
    color: #e0e0e0;
    border: 1px solid #3a3b3c;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 13px;
}

/* ========================================================================= */
/* [ CHECKBOXES ]                                                            */
/* ========================================================================= */
/* ONE indicator app-wide (the Environment tab's toggles, the General page's ping toggle, any
   checkbox a dialog grows): a dark well with the app's hover accent; checked = the accent check
   glyph in the well rather than a solid fill (a filled square read as a button). Only the label
   color/size differs per panel — see _environment.qss and _preferences.qss. */
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4a4b4d;
    border-radius: 3px;
    background: #2a2b2d;
}

QCheckBox::indicator:hover {
    border-color: #5b87cc; /* the app accent (Constants::COLOR_ACCENT) — same as the DragNumberBox hover border */
}

QCheckBox::indicator:checked {
    background: #2a2b2d;
    image: url(:/resources/icons/check.png);
}

/* ========================================================================= */
/* [ DIALOGS (QMessageBox, etc.) ]                                          */
/* ========================================================================= */

QDialog {
    background-color: #191a1b;
}

QMessageBox QLabel {
    /* Overrides the global white QLabel color above with a softer tone, */
    /* and drops the 18px default size that's sized for the main window. */
    color: #e0e0e0;
    font-size: 13px;
}

QDialog QPushButton {
    background-color: #2a2d30;
    color: #e0e0e0;
    border: 1px solid #3a3b3c;
    border-radius: 4px;
    padding: 6px 16px;
    min-width: 70px;
}

QDialog QPushButton:hover {
    background-color: #3a3b3c;
}

QDialog QPushButton:pressed {
    background-color: #5b87cc;
}

QDialog QPushButton:default {
    /* Highlights whichever button Enter/Return will trigger */
    border: 1px solid #5b87cc;
}

/* ========================================================================= */
/* [ SCROLLBARS ]                                                            */
/* ========================================================================= */
/* The app-wide vertical scrollbar theme. Unscoped on purpose: every scroll   */
/* area gets it. It used to sit in _assetmanager.qss under a "grid scrollbar" */
/* heading while in fact styling every vertical scrollbar in the app.         */

QScrollBar:vertical {
    width: 14px;
    margin: 0px;
    background-color: #1a1b1c;
    border: none;
}

QScrollBar::handle:vertical {
    min-height: 20px;
    margin: 2px; 
    background-color: #3a3b3c;
    border-radius: 5px; 
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4b4c; 
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px; 
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
