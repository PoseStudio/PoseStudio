# ==========================================
# PoseStudio .gitignore
# ==========================================

# ------------------------------------------
# C++ / Compiled Object Files & Libraries
# ------------------------------------------
# NOTE: no `*.obj` rule here on purpose — Wavefront OBJ models share that extension and are
# legitimate content in a 3D app's repo (e.g. sample assets). MSVC object files only ever land
# in build directories, which are already ignored below.
*.slo
*.lo
*.o
*.gch
*.pch
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app

# ------------------------------------------
# Python (future plugins & scripting)
# ------------------------------------------
# Kept deliberately minimal: unanchored packaging rules like `lib/`, `dist/`, or `var/` would
# silently hide a future real source or asset directory anywhere in the tree.
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env

# ------------------------------------------
# Qt Framework (UI/Frontend)
# ------------------------------------------
# Qt moc, uic, rcc generated files
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
Makefile*
*build-*/
*.qstash
*.qmlc
*.jsc

# ------------------------------------------
# CMake (Build System)
# ------------------------------------------
build/
CMakeCache.txt
CMakeFiles
CMakeScripts
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps

# ------------------------------------------
# IDEs and Editors
# ------------------------------------------
# Visual Studio / VS Code
.vscode/
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln.docstates

# CLion / IntelliJ / JetBrains
.idea/
cmake-build-*/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# ------------------------------------------
# 3D Cache & Local Assets (PoseStudio Specific)
# ------------------------------------------
# Prevent large test assets and temp cache from bloating the repo
/local_assets/
/test_cache/
*.zpr.backup
*.fbx.bak
*.obj.bak
# Ignore large log files generated from rendering or crashing
*.log
crash_dumps/

# Editor/assistant scratch directories (agent worktrees, session data) — never publish
.claude/